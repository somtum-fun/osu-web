FROM --platform=$BUILDPLATFORM almalinux:10-minimal as buildenv

COPY .php-version .node-version /

RUN echo "install_weak_deps=False" >> /etc/dnf/dnf.conf && \
    # shadow-utils is required for build script and frankenphp package install
    microdnf install -y epel-release shadow-utils && \
    rpm -i https://rpm.henderkes.com/static-php-1-1.noarch.rpm && \
    microdnf module enable -y php-zts:static-$(cat /.php-version) && \
    (curl -fsSL https://rpm.nodesource.com/setup_$(cat /.node-version).x | bash -) && \
    microdnf install -y \
      frankenphp \
      git \
      nodejs \
      php-zts-cli \
      php-zts-ds \
      php-zts-fileinfo \
      php-zts-ffi \
      php-zts-ftp \
      php-zts-gd \
      php-zts-gettext \
      php-zts-intl \
      php-zts-mysqli \
      php-zts-mysqlnd \
      php-zts-pdo \
      php-zts-pdo_mysql \
      php-zts-pdo_sqlite \
      php-zts-redis \
      php-zts-shmop \
      php-zts-sysvmsg \
      php-zts-sysvsem \
      php-zts-sysvshm \
      php-zts-xsl \
      php-zts-zip \
      unzip && \
    microdnf clean all

RUN corepack enable yarn

WORKDIR /app

RUN curl -L "https://getcomposer.org/download/latest-2.x/composer.phar" > /usr/local/bin/composer && chmod 755 /usr/local/bin/composer

COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts

COPY package.json yarn.lock ./
RUN yarn --prod --ignore-optional --frozen-lockfile


FROM almalinux:10-minimal as runenv

COPY .php-version /

RUN echo "install_weak_deps=False" >> /etc/dnf/dnf.conf && \
    # shadow-utils is required for build script and frankenphp package install
    microdnf install -y epel-release shadow-utils && \
    rpm -i https://rpm.henderkes.com/static-php-1-1.noarch.rpm && \
    microdnf module enable -y php-zts:static-$(cat /.php-version) && \
    microdnf install -y \
      ffmpeg-free \
      frankenphp \
      libjpeg-turbo-utils \
      nginx \
      php-zts-cli \
      php-zts-ds \
      php-zts-fileinfo \
      php-zts-ffi \
      php-zts-ftp \
      php-zts-gd \
      php-zts-gettext \
      php-zts-intl \
      php-zts-mysqli \
      php-zts-mysqlnd \
      php-zts-pdo \
      php-zts-pdo_mysql \
      php-zts-pdo_sqlite \
      php-zts-redis \
      php-zts-shmop \
      php-zts-sysvmsg \
      php-zts-sysvsem \
      php-zts-sysvshm \
      php-zts-xsl \
      php-zts-zip && \
    microdnf clean all

RUN ln -s /app/docker/php.ini /etc/php-zts/conf.d/zz-osuweb.ini

RUN rm -f /var/log/nginx/access.log /var/log/nginx/error.log && \
    ln -s /dev/stdout /var/log/nginx/access.log && \
    ln -s /dev/stderr /var/log/nginx/error.log


# TomYum: the website's assets in steps of their own, so a deploy that changes no front-end file reuses them
# (webpack took minutes on every deploy, a PHP-only change included). First the files they're built from that
# PHP makes (routes for ziggy, translations, mod names): this step runs on every change, but takes seconds, and
# its result only differs when routes, translations or mods do.
FROM buildenv as builds

COPY . .
RUN php artisan ziggy:generate resources/builds/ziggy.js --types && \
    node -e "require('./resources/js/cli/generate-localizations')(); require('./resources/js/cli/mod-names-generator')()"

# Then webpack, with only what it reads: reused while none of it changes.
FROM buildenv as assets

COPY package.json tsconfig.json webpack.config.js ./
COPY database/mods.json database/
COPY public/images public/images
COPY resources/css resources/css
COPY resources/fonts resources/fonts
COPY resources/images resources/images
COPY resources/js resources/js
COPY --from=builds /app/resources/builds resources/builds

ARG APP_URL
ARG DOCS_URL
ENV WEBPACK_PREBUILT=1
RUN yarn production


FROM buildenv as build

COPY . .
RUN mkdir -p bootstrap/cache storage/logs storage/framework/cache storage/framework/views storage/framework/sessions public/uploads public/uploads-avatar public/uploads-replay

COPY --from=assets /app/public/assets public/assets
COPY --from=assets /app/resources/builds resources/builds

RUN php artisan ip2asn:update
RUN php artisan scribe:generate
# TomYum: our addresses in the docs' examples, not osu!'s.
RUN php artisan tomyum:docs-hosts

RUN rm -rf node_modules

RUN composer dump-autoload

ARG GIT_SHA
RUN printf "%s" "$GIT_SHA" > version


FROM runenv as run

COPY --from=build /app /app
WORKDIR /app

RUN useradd -m osuweb
RUN chown -R osuweb /var/lib/nginx bootstrap/cache storage
USER osuweb
ENV LOG_CHANNEL stderr
# fix broken readline in php console
ENV TERMINFO /usr/share/terminfo

EXPOSE 8000
EXPOSE 8080

ENTRYPOINT ["/app/docker/deployment/entrypoint.sh"]
